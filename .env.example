# Get from https://aistudio.google.com
GEMINI_API_KEY=

# OCR model — reads scanned Marathi/Hindi PDF pages
# gemini-3.8-flash: best Devanagari accuracy, speed not critical (background job)
GEMINI_OCR_MODEL=gemini-3.8-flash

# Chat model — generates answers for staff questions
# gemini-3.1-flash-lite: fastest + correctly follows language instruction
# gemini-3.5-flash-lite: fast but answers in Marathi regardless of question language
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Which model makes the embeddings: gemini (the default, 768 dimensions), local (768) or bge
# (BAAI/bge-m3, 1024 dimensions, runs on this machine, free). The database holds Gemini vectors;
# switching to another model means re-embedding every chunk (see backend/ingest/reembed_all.py).
EMBEDDING_ENGINE=gemini

# Only used when EMBEDDING_ENGINE=gemini - never change after first ingest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Neon Postgres connection string from https://neon.tech
DATABASE_URL=

# Folder ID from your Google Drive folder URL
GOOGLE_DRIVE_FOLDER_ID=

# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Directory for OCR text cache (not PDFs — PDFs stream from Drive)
OCR_CACHE_DIR=./staging/ocr_cache

# Number of parallel OCR workers (default 4, max 8 for t3.large)
OCR_CONCURRENCY=4

# OCR engine: gemini (default, paid) or a free engine that runs on this machine:
#   tesseract  needs: brew install tesseract tesseract-lang
#   easyocr    needs: uv sync --extra easyocr   (large: installs PyTorch)
#   paddle     needs: uv sync --extra paddle    (large: installs PaddlePaddle)
# Pages already cached by one engine are reused as they are when you switch
OCR_ENGINE=gemini

# Where "View page" images are cached once drawn from the Drive PDFs (trimmed to 500 MB)
PAGE_CACHE_DIR=./staging/page_cache
