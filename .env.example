# Get from https://aistudio.google.com
GEMINI_API_KEY=

# OCR model — reads scanned Marathi/Hindi PDF pages
# gemini-3.8-flash: best Devanagari accuracy, speed not critical (background job)
GEMINI_OCR_MODEL=gemini-3.8-flash

# Chat model — generates answers for staff questions
# gemini-3.1-flash-lite: fastest + correctly follows language instruction
# gemini-3.5-flash-lite: fast but answers in Marathi regardless of question language
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Which model makes the embeddings: gemini (the default, 768 dimensions), local (768) or bge
# (BAAI/bge-m3, 1024 dimensions, runs on this machine, free; needs `uv sync --extra local-embeddings`). The database holds Gemini
# vectors; switching to another model means re-embedding every chunk, and for a live site that must be done without emptying the
# vectors first: read docs/embeddings-bge-m3.md before setting this to bge anywhere that talks to the live database.
EMBEDDING_ENGINE=gemini

# Only used when EMBEDDING_ENGINE=gemini - never change after first ingest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Postgres connection string (the database needs the pgvector extension, installed in schema public).
# Supabase: use the SESSION pooler string from Connect in the dashboard, not the direct db.<ref>.supabase.co host (that one is IPv6 only,
# which the EC2 server and most office networks do not have):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Percent-encode special characters in the password. Neon (https://neon.tech) works the same way. See docs/database-migration.md.
DATABASE_URL=

# Folder ID from your Google Drive folder URL
GOOGLE_DRIVE_FOLDER_ID=

# Path to your Google service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Directory for OCR text cache (not PDFs — PDFs stream from Drive)
OCR_CACHE_DIR=./staging/ocr_cache

# Number of parallel OCR workers (default 4, max 8 for t3.large)
OCR_CONCURRENCY=4

# OCR engine: gemini (default, paid) or a free engine that runs on this machine:
#   tesseract  needs: brew install tesseract tesseract-lang
#   easyocr    needs: uv sync --extra easyocr   (large: installs PyTorch)
#   paddle     needs: uv sync --extra paddle    (large: installs PaddlePaddle)
# Pages already cached by one engine are reused as they are when you switch
OCR_ENGINE=gemini

# Where "View page" images are cached once drawn from the Drive PDFs (trimmed to 500 MB)
PAGE_CACHE_DIR=./staging/page_cache

# API keys: every backend route except /health needs one, and the backend will not start without
# both. Make each with `openssl rand -hex 32`; they must differ. The web app's server sends them
# (set BACKEND_API_KEY = API_KEY and BACKEND_ADMIN_KEY = ADMIN_API_KEY in web/.env.local and in
# Vercel); a browser never sees them.
# API_KEY: the chat and the page images.  ADMIN_API_KEY: the document list, ingestion, the audit log.
API_KEY=
ADMIN_API_KEY=

# Single sign-on from the MCCIA App Hub (web app / Vercel project mccia-search). Staff sign in once on the hub and open this
# app from its card; the hub sends a signed token, which this app checks with the hub's PUBLIC key. No password lives here.
#   HUB_SSO_PUBLIC_KEY  the hub's public key, base64 of its PEM (the hub keeps the private one as SSO_PRIVATE_KEY)
#   HUB_URL             the hub's address, e.g. https://mccia-apphub.vercel.app
#   SSO_AUDIENCE        this app's slug in the hub (default mccia-search)
#   SESSION_SECRET      at least 32 random characters; signs this app's 2-hour session cookie
#   SSO_ENFORCE         true = everyone must sign in through the hub; anything else = the site stays open as before
#                       (the way back if something goes wrong: set it to false and redeploy)
HUB_SSO_PUBLIC_KEY=
HUB_URL=
SSO_AUDIENCE=mccia-search
SESSION_SECRET=
SSO_ENFORCE=false

# Keep-warm pings (backend/keepwarm.py): every 4 minutes the backend sends a cheap GET to the web app's sign-in function, because
# Vercel's free plan cannot run a cron more than once a day and an idle function goes cold within minutes. The default is the live
# web app; set KEEP_WARM_URLS=off when running the backend on your own machine. Several addresses: comma-separated.
KEEP_WARM_URLS=https://mccia-search.vercel.app/api/sso/callback
