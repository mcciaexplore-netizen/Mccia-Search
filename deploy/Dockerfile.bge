# The backend with bge-m3 on board (run it with EMBEDDING_ENGINE=bge). Build it on the server, from the repository root, because it copies
# the server's own .env (database and API keys) and credentials.json into the image, as the current Gemini image does:
#   docker build -f deploy/Dockerfile.bge -t mccia-backend:bge .
# The model (2.3 GB) is NOT in the image: it sits in a folder on the server that is mounted at /models, so a rebuild is quick and the
# model is downloaded once. deploy/bge-switch.sh does all of this.
FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv
# torch first, from PyTorch's CPU-only index: the default build drags in several GB of NVIDIA GPU libraries this server cannot use.
RUN uv pip install --system torch --index-url https://download.pytorch.org/whl/cpu
COPY backend/pyproject.toml .
RUN uv pip install --system -r pyproject.toml --extra local-embeddings
# The build stops here if a GPU build of torch (or its NVIDIA libraries) slipped in anyway.
RUN python -c "import importlib.util as u, torch; assert '+cpu' in torch.__version__, torch.__version__; assert u.find_spec('nvidia') is None, 'NVIDIA libraries were installed'"
COPY backend/ ./backend/
COPY .env .env
COPY credentials.json ./credentials.json
ENV HF_HOME=/models
WORKDIR /app/backend
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
